<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
  </PropertyGroup>
  <Import Project="Local.props" Condition="Exists('Local.props')" />
  <!-- The vendored DLLs in lib/ are used unless a Local.props overrides
       VintageStoryPath to build against a different game installation. -->
</Project>
